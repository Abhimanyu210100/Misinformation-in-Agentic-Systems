+# Set by the parent repo's scripts/run_tau2.py; see its patches/tau2_qwen_tools_in_prompt.patch.
+QWEN_TOOLS_IN_PROMPT = os.environ.get("TAU2_QWEN_TOOLS_IN_PROMPT") == "1"
+_QWEN_DEFAULT_SYSTEM = "You are Qwen, created by Alibaba Cloud. You are a helpful assistant."
+_QWEN_TOOLS_HEADER = (
+    "\n\n# Tools\n\nYou may call one or more functions to assist with the user query.\n\n"
+    "You are provided with function signatures within <tools></tools> XML tags:\n<tools>"
+)
+_QWEN_TOOLS_FOOTER = (
+    "\n</tools>\n\nFor each function call, return a json object with function name and "
+    "arguments within <tool_call></tool_call> XML tags:\n<tool_call>\n"
+    '{"name": <function-name>, "arguments": <args-json-object>}\n</tool_call>'
+)
+_QWEN_TOOL_CALL_RE = re.compile(r"<tool_call>(.*?)(?:</tool_call>|\Z)", re.DOTALL)
+
+
+def _uses_tools(litellm_messages: list[dict], tools_schema: Optional[list[dict]]) -> bool:
+    return bool(tools_schema) or any(
+        m["role"] == "tool" or m.get("tool_calls") for m in litellm_messages
+    )
+
+
+def to_qwen_text_messages(
+    litellm_messages: list[dict], tools_schema: Optional[list[dict]]
+) -> list[dict]:
+    """Write tools, tool calls and tool results as plain chat text, exactly as
+    Qwen2.5's chat template renders them, so no tool fields reach the server."""
+    messages = litellm_messages
+    if messages and messages[0]["role"] == "system":
+        system, messages = messages[0]["content"], messages[1:]
+    else:
+        system = _QWEN_DEFAULT_SYSTEM
+    if tools_schema:
+        system += (
+            _QWEN_TOOLS_HEADER
+            + "".join("\n" + json.dumps(t, ensure_ascii=False) for t in tools_schema)
+            + _QWEN_TOOLS_FOOTER
+        )
+    out = [{"role": "system", "content": system}]
+    previous_role = "system"
+    for m in messages:
+        if m["role"] == "tool":
+            block = "<tool_response>\n" + m["content"] + "\n</tool_response>"
+            if previous_role == "tool":
+                out[-1]["content"] += "\n" + block
+            else:
+                out.append({"role": "user", "content": block})
+        elif m["role"] == "assistant" and m.get("tool_calls"):
+            calls = "".join(
+                '\n<tool_call>\n{"name": "'
+                + tc["function"]["name"]
+                + '", "arguments": '
+                + json.dumps(json.loads(tc["function"]["arguments"]), ensure_ascii=False)
+                + "}\n</tool_call>"
+                for tc in m["tool_calls"]
+            )
+            content = m["content"] + calls if m.get("content") else calls[1:]
+            out.append({"role": "assistant", "content": content})
+        else:
+            out.append({"role": m["role"], "content": m["content"]})
+        previous_role = m["role"]
+    return out
+
+
+def parse_qwen_tool_calls(text: Optional[str]) -> tuple[Optional[str], list[ToolCall]]:
+    """Split a Qwen reply into text and <tool_call> blocks. A reply with any block
+    that isn't a valid {"name", "arguments"} object stays plain text, as in
+    vLLM's hermes parser."""
+    if not text or "<tool_call>" not in text:
+        return text, []
+    tool_calls = []
+    for block in _QWEN_TOOL_CALL_RE.findall(text):
+        try:
+            call = json.loads(block)
+            arguments = call.get("arguments") or {}
+            if isinstance(arguments, str):
+                arguments = json.loads(arguments)
+            if not isinstance(call["name"], str) or not isinstance(arguments, dict):
+                return text, []
+        except (ValueError, AttributeError, KeyError, TypeError):
+            return text, []
+        tool_calls.append(
+            ToolCall(
+                id=f"call_{uuid.uuid4().hex[:24]}",
+                name=call["name"],
+                arguments=arguments,
+            )
+        )
+    return _QWEN_TOOL_CALL_RE.sub("", text).strip() or None, tool_calls
+
